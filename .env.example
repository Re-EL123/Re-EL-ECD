# Re-EL ECD environment configuration
# Copy to .env and fill in the values for your environment. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0

# PostgreSQL (Neon recommended in production).
# Leave blank in development to use the embedded PGlite database.
DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=10
# Allow for a suspended Neon compute waking on the first request.
DATABASE_CONNECT_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Sessions
SESSION_HOURS=8

# Comma-separated list of allowed frontend origins.
# Required in production when the frontend is hosted separately (GitHub Pages).
# Example: FRONTEND_ORIGIN=https://re-el123.github.io
FRONTEND_ORIGIN=

# Set to true when the frontend and API are on different sites so the session
# cookie is issued with SameSite=None; Secure. Requires HTTPS.
CROSS_SITE_COOKIES=false

# Refuse to start in production without a real database unless explicitly allowed.
ALLOW_IN_MEMORY_DB=false

# Demonstration seed password (development only). Change or omit in production.
DEMO_PASSWORD=Re-EL-Demo-2026!

# Optional email delivery provider key. Notifications are recorded in the
# database when no provider is configured.
EMAIL_API_KEY=

# Transactional email through Resend (https://resend.com).
# When RESEND_API_KEY is blank every send is logged as "skipped" in
# email_deliveries instead of failing the operation that triggered it.
RESEND_API_KEY=
EMAIL_FROM=Re-EL ECD <no-reply@re-el.co.za>
EMAIL_REPLY_TO=
EMAIL_ENABLED=true
EMAIL_TIMEOUT_MS=10000

# Public URL of the web app, used in email links and PayFast return URLs.
APP_BASE_URL=https://ecd.re-el.co.za
# Public URL of the API, used for the PayFast ITN callback.
API_BASE_URL=

# PayFast hosted checkout (South Africa).
# Leave blank to disable online card payments; invoices remain payable by EFT.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Optional comma-separated list of PayFast IP addresses allowed to post ITNs.
PAYFAST_IP_ALLOWLIST=
# Set to false only if you cannot reach PayFast's validate endpoint.
PAYFAST_VALIDATE=true
PAYFAST_TIMEOUT_MS=10000
