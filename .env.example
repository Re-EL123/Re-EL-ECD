# Re-EL ECD environment configuration
# Copy to .env and fill in the values for your environment. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0

# PostgreSQL (Neon recommended in production).
# Leave blank in development to use the embedded PGlite database.
DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# Sessions
SESSION_HOURS=8

# Comma-separated list of allowed frontend origins.
# Required in production when the frontend is hosted separately (GitHub Pages).
# Example: FRONTEND_ORIGIN=https://re-el123.github.io
FRONTEND_ORIGIN=

# Set to true when the frontend and API are on different sites so the session
# cookie is issued with SameSite=None; Secure. Requires HTTPS.
CROSS_SITE_COOKIES=false

# Refuse to start in production without a real database unless explicitly allowed.
ALLOW_IN_MEMORY_DB=false

# Demonstration seed password (development only). Change or omit in production.
DEMO_PASSWORD=Re-EL-Demo-2026!

# Optional email delivery provider key. Notifications are recorded in the
# database when no provider is configured.
EMAIL_API_KEY=
