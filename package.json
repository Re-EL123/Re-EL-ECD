{
  "name": "re-el-ecd",
  "private": true,
  "version": "1.0.0",
  "description": "Re-EL ECD - Multi-tenant SaaS platform for Early Childhood Development centres",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web & npm run dev:api",
    "dev:web": "cd apps/web && npx serve .",
    "dev:api": "cd apps/api && vercel dev",
    "build": "npm run build:web",
    "build:web": "echo 'Static build'",
    "test": "echo 'Tests'",
    "lint": "echo 'Lint'",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed-development.js"
  },
  "devDependencies": {
    "serve": "^14.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
